{
  "name": "react-kui",
  "private": false,
  "version": "2.0.1",
  "description": "A lightweight desktop UI component library suitable for React",
  "type": "module",
  "main": "lib/index.js",
  "module": "es/index.js",
  "unpkg": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "style": "style/index.css",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    },
    "./dist/*": "./dist/*",
    "./global": {
      "types": "./types/global.d.ts"
    },
    "./locale/*": {
      "types": "./types/locale/*.d.ts",
      "import": "./es/locale/*.js",
      "require": "./lib/locale/*.js"
    },
    "./style/*": "./style/*"
  },
  "files": [
    "dist",
    "test",
    "vetur",
    "lib",
    "style",
    "es",
    "types"
  ],
  "license": "MIT",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite --config vite.config.docs.ts",
    "build": "npm run build:css && npm run build:lib && npm run build:umd && npm run build:es",
    "build:es": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:umd": "vite build --config vite.config.umd.ts",
    "build:css": "vite build --config vite.config.css.ts",
    "build:docs": "vite build --config vite.config.docs.ts",
    "preview": "vite preview --outDir docs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "format": "prettier --write .",
    "format:md": "prettier --write ./components/*/index*.md"
  },
  "author": {
    "name": "Qiu",
    "email": "smallerqiu@gmail.com"
  },
  "homepage": "https://react.k-ui.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/smallerqiu/kui-react"
  },
  "bugs": {
    "url": "https://github.com/smallerqiu/kui-react/issues",
    "email": "smallerqiu@gmail.com"
  },
  "keywords": [
    "ui",
    "kui",
    "kui-react",
    "react-kui",
    "kyui",
    "react",
    "react kui",
    "react ui",
    "component",
    "components",
    "framework",
    "react components",
    "pc",
    "pc ui"
  ],
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-transition-group": "^4.4.5"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "dependencies": {
    "big.js": "^7.0.1",
    "color": "^5.0.3",
    "dayjs": "^1.11.21",
    "kui-icons": "^5.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "hash-sum": "^2.0.0",
    "highlight.js": "^11.11.1",
    "less": "^4.6.4",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "prettier": "^3.8.3",
    "prop-types": "^15.8.1",
    "react-router": "^7.17.0",
    "sucrase": "^3.35.1",
    "terser": "^5.48.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  },
  "vetur": {
    "tags": "vetur/tags.json",
    "attributes": "vetur/attributes.json"
  },
  "web-types": "./vetur/web-types.json"
}
