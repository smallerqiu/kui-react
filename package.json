{
  "name": "react-kui",
  "version": "3.0.0",
  "description": "A high quality UI components Library with React",
  "main": "dist/k-ui.js",
  "style": "dist/k-ui.css",
  "scripts": {
    "dev": "vite --config vite.config.docs.ts",
    "start": "npm run dev",
    "typecheck": "tsc -b",
    "build:es": "vite build --config vite.config.ts",
    "build:cjs": "vite build --config vite.config.lib.ts",
    "build:css": "vite build --config vite.config.css.ts",
    "build:docs": "vite build --config vite.config.docs.ts",
    "build": "npm run typecheck && npm run build:es && npm run build:cjs && npm run build:css"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/chuchur/kui-react.git"
  },
  "bugs": {
    "url": "https://gitee.com/chuchur/kui-react/issues",
    "email": "chuchur@qq.com"
  },
  "keywords": [
    "react",
    "reactjs",
    "kui",
    "kui-react",
    "design",
    "react-components",
    "ui",
    "ui-library",
    "react19-components",
    "ui-kit"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "dependencies": {
    "big.js": "^7.0.1",
    "color": "^5.0.3",
    "dayjs": "^1.11.21",
    "kui-icons": "^5.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/big.js": "^7.0.0",
    "@types/hash-sum": "^1.0.2",
    "@types/node": "^25.9.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "hash-sum": "^2.0.0",
    "highlight.js": "^11.11.1",
    "less": "^4.8.0",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "qrcode": "^1.5.4",
    "react-router": "^7.18.1",
    "sucrase": "^3.35.1",
    "terser": "^5.49.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3"
  },
  "vetur": {
    "tags": "vetur/tags.json",
    "attributes": "vetur/attributes.json"
  },
  "web-types": "./vetur/web-types.json"
}
