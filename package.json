{
  "name": "react-kui",
  "version": "3.1.2",
  "packageManager": "pnpm@12.4.2",
  "description": "A high quality UI components Library with React",
  "main": "./lib/index.cjs",
  "module": "./es/index.js",
  "types": "./types/index.d.ts",
  "style": "./style/index.css",
  "type": "module",
  "files": [
    "es",
    "lib",
    "style",
    "types",
    "readme.md",
    "README.zh-CN.md",
    "ai",
    "AI.md",
    "AI.en-US.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./es/index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./style": "./style/index.css",
    "./style.css": "./style/index.css",
    "./style/*": "./style/*",
    "./locale/*": {
      "import": {
        "types": "./types/locale/*.d.ts",
        "default": "./es/locale/*.js"
      },
      "require": {
        "types": "./types/locale/*.d.cts",
        "default": "./lib/locale/*.cjs"
      }
    },
    "./package.json": "./package.json",
    "./metadata": "./ai/kui-components.json",
    "./metadata/schema": "./ai/kui-components.schema.json",
    "./skill": "./ai/skills/react-kui/SKILL.md",
    "./skill/*": "./ai/skills/react-kui/*"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "scripts": {
    "check:theme": "node --experimental-strip-types --max-old-space-size=512 scripts/check-theme.ts",
    "dev": "vite --config vite.config.docs.ts",
    "start": "pnpm dev",
    "typecheck": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc -b",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "build:es": "node --experimental-strip-types scripts/prepare-types.ts --clean && node --max-old-space-size=2048 node_modules/vite/bin/vite.js build --config vite.config.ts && node --experimental-strip-types scripts/prepare-types.ts",
    "build:cjs": "node --max-old-space-size=2048 node_modules/vite/bin/vite.js build --config vite.config.lib.ts",
    "build:css": "node --max-old-space-size=2048 node_modules/vite/bin/vite.js build --config vite.config.css.ts",
    "build:docs": "pnpm generate:ai && node --max-old-space-size=2048 node_modules/vite/bin/vite.js build --config vite.config.docs.ts",
    "build:lib": "pnpm generate:ai && pnpm build:es && pnpm build:cjs && pnpm build:css",
    "build": "pnpm typecheck && pnpm build:lib",
    "lint": "node --max-old-space-size=2048 node_modules/eslint/bin/eslint.js . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "pnpm lint -- --fix",
    "eslint": "pnpm lint",
    "generate:api-docs": "node --max-old-space-size=2048 --experimental-strip-types scripts/generate-ai-assets.ts --docs",
    "check:api-types": "node --max-old-space-size=2048 --experimental-strip-types scripts/generate-ai-assets.ts --check-docs",
    "check:api-docs": "node --max-old-space-size=2048 --experimental-strip-types scripts/check-api-docs.ts && pnpm check:api-types",
    "package:check": "node --experimental-strip-types scripts/check-package.ts",
    "test": "node --max-old-space-size=2048 node_modules/vitest/vitest.mjs run --maxWorkers=1",
    "verify": "pnpm check && pnpm build:lib && pnpm build:docs && pnpm package:check",
    "generate:ai": "node --max-old-space-size=2048 --experimental-strip-types scripts/generate-ai-assets.ts",
    "check:ai-assets": "node --max-old-space-size=2048 --experimental-strip-types scripts/generate-ai-assets.ts --check && pnpm audit:ai-metadata",
    "audit:ai-metadata": "node --experimental-strip-types scripts/audit-ai-metadata.ts",
    "check:ai": "pnpm check:ai-evals && pnpm typecheck:ai && node --max-old-space-size=2048 node_modules/vitest/vitest.mjs run tests/ai-assets.test.ts tests/ai-templates.test.tsx tests/ai-evals.test.mjs --maxWorkers=1",
    "typecheck:ai": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc -p tsconfig.ai-templates.json --noEmit",
    "check": "pnpm lint && pnpm check:api-docs && pnpm typecheck && pnpm typecheck:ai && pnpm check:ai-assets && pnpm check:ai-evals && pnpm test",
    "package:smoke": "node --experimental-strip-types scripts/smoke-package.ts",
    "check:ai-evals": "node ai/evals/run.mjs --reference",
    "eval:ai": "node ai/evals/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smallerqiu/kui-react.git"
  },
  "bugs": {
    "url": "https://github.com/smallerqiu/kui-react/issues",
    "email": "chuchur@qq.com"
  },
  "keywords": [
    "react",
    "reactjs",
    "kui",
    "kui-react",
    "design",
    "react-components",
    "ui",
    "ui-library",
    "react19-components",
    "ui-kit"
  ],
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "dependencies": {
    "@babel/parser": "7.29.8",
    "big.js": "^7.0.1",
    "clsx": "^2.1.1",
    "color": "^5.0.3",
    "dayjs": "^1.11.23",
    "kui-icons": "^5.0.0",
    "qrcode": "^1.5.4",
    "react-transition-group": "^4.4.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stackblitz/sdk": "^1.11.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/big.js": "^7.0.0",
    "@types/hash-sum": "^1.0.2",
    "@types/less": "^3.0.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "codejar": "^4.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "hash-sum": "^2.0.0",
    "highlight.js": "^11.12.0",
    "html-react-parser": "^6.1.7",
    "jsdom": "^30.0.1",
    "less": "^4.9.1",
    "lz-string": "^1.5.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^9.2.1",
    "nuqs": "^2.10.1",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react-router": "^7.18.3",
    "sucrase": "^3.35.1",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11"
  },
  "bin": {
    "react-kui-ai": "./ai/cli.mjs",
    "react-kui-mcp": "./ai/mcp.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
