{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "esnext",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "esnext",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    /* alias */
    "rootDir": ".",
    "paths": {
      "react-kui": [
        "./components/index.ts"
      ],
      "react-kui/*": [
        "./components/*"
      ],
      "@/*": [
        "/*"
      ]
    },
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.tsx",
    "plugins/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config*.ts"
  ]
}